      "source_status": "admitted",
      "execution_status": "community_confirmed",
      "delivery": "remote_installer",
      "supported_images": [
        "openatv",
        "openvix",
        "openpli",
        "openhdf",
        "generic-enigma2"
      ],
      "supported_architectures": [
        "armv7l",
        "arm",
        "arm64",
        "mips",
        "mipsel",
        "x86",
        "x86_64"
      ],
      "requires_gui_restart": true,
      "requires_reboot": false,
      "notes": "Pinned installer source. The installer is executed locally on the receiver with SKIP_REBOOT=1 so Enigma2 restart remains under the panel's controlled restart flow."
    },
