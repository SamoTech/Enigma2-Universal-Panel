{
  "schema_version": 1,
  "policy": {
    "binaries_hosted_in_repository": false,
    "source_ref_required": true,
    "installer_blob_sha_required": true,
    "arbitrary_urls": false,
    "arbitrary_shell": false,
    "direct_remote_installer": true,
    "tls_certificate_verification_required": true,
    "allow_admitted_insecure_transport": true,
    "restart_environment": "SKIP_REBOOT=1",
    "compatibility_fail_closed": true
  },
